# NOTORIUS — environment template
# Copy to `.env.local` for local overrides. Do not commit real secrets.
#
# Current app runtime: NO required variables.
# The demo API uses an in-memory store; Web3 uses public RPCs.
# Variables below are optional ecosystem hooks (Melano Inc cloud / future wiring).

# --- App ---
# PORT=3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase (optional; not required by current Notorius code paths) ---
# Use a live project URL (CRM-MELANIA: mbxjrdgbgwaaboldzhph).
# Stale/deleted project refs will fail DNS and probes.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# --- SQL database URLs/credentials (optional; usually from Supabase) ---
# Use your platform's standard DB URL vars in the cloud environment.
# PG_URL=
# PG_PRISMA_URL=
# PG_URL_NON_POOLING=
# PG_USER=
# PG_PASSWORD=
# PG_DATABASE=
# PG_HOST=

# --- Mercado Pago (optional; not required by current Notorius code paths) ---
# Prefer OAuth app credentials (client_credentials). A stale ACCESS_TOKEN often 403s.
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# --- Hostinger SSH (optional ops; not required by app runtime) ---
# HOST must be a real hostname/IP — not the SSH username.
# Bad: HOSTINGER_SSH_HOST=root
# Good: HOSTINGER_SSH_HOST=srv123.hostinger.com + HOSTINGER_SSH_USER=root
# HOSTINGER_SSH_HOST=your.server.example
# HOSTINGER_SSH_USER=root
# HOSTINGER_SSH_PORT=22
# HOSTINGER_SSH_PRIVATE_KEY=

# --- Meta WhatsApp Cloud API (optional; chat bots / Luxia-Alenya bridge) ---
# Phone Number ID from Meta Developer → WhatsApp → API Setup (digits only).
# WHATSAPP_PHONE_NUMBER_ID=
# META_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_WHATSAPP_TOKEN=

# --- Web3 (optional overrides; defaults use public Polygon RPCs) ---
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
