# NOTORIUS — environment template
# Copy to `.env.local` for local overrides. Do not commit real secrets.
#
# Production (capital-real foundation):
# - Supabase with migrated notorius_* tables (see supabase/migrations/)
# - ECOSYSTEM_HANDOFF_SECRET required
# - NOTORIUS_OPERATOR_KEY and/or Supabase operator JWT for mutable APIs
# - Ledger mint/transfer require real on-chain txHash (except NOTORIUS_FORCE_MEMORY=1 / tests)

# --- App ---
# PORT=3000
# NEXT_PUBLIC_APP_URL=https://notorius.melanoinc.com
# NEXT_PUBLIC_BASE_URL=https://notorius.melanoinc.com

# Force in-memory store + demo ledger (synthetic tx hashes allowed)
# NOTORIUS_FORCE_MEMORY=1
# NOTORIUS_STORE=memory  # alternate force-memory flag used by main dual-write path

# Shared secret for POST /api/ecosystem/handoff (REQUIRED in production)
# ECOSYSTEM_HANDOFF_SECRET=

# Operator API key for mutable dashboard/API routes (alt: Supabase Auth JWT of notorius_operators)
# NOTORIUS_OPERATOR_KEY=

# Melano admin panel (/admin/login) — cookie session for dashboard + ledger GETs
# NOTORIUS_ADMIN_PASSWORD=
# NOTORIUS_ADMIN_SESSION_SECRET=

# --- Supabase (persistence) ---
# Capital-real path: dedicated notorius_* tables (supabase/migrations/).
# Live Melano project used for migrations: CRM-MELANIA (mbxjrdgbgwaaboldzhph)
# Prefer NOTORIUS_* so stale cloud SUPABASE_* hosts do not override.
# NOTORIUS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NOTORIUS_SUPABASE_ANON_KEY=
# NOTORIUS_SUPABASE_SERVICE_ROLE_KEY=
# NOTORIUS_COMPANY_ID=   # companies.id UUID (Melano Inc row; used by dual-write repository)
# NEXT_PUBLIC_SUPABASE_URL=https://mbxjrdgbgwaaboldzhph.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=https://mbxjrdgbgwaaboldzhph.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# --- Mercado Pago (optional; probe only today) ---
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# --- Hostinger (optional ops) ---
# HOSTINGER_API_KEY=
# HOSTINGER_SSH_HOST=your.server.example
# HOSTINGER_SSH_USER=root
# HOSTINGER_SSH_PORT=22
# HOSTINGER_SSH_PRIVATE_KEY=

# --- aLENYA Command Center (CRM-MELANIA) ---
# ALENYA_SUPABASE_URL=https://mbxjrdgbgwaaboldzhph.supabase.co
# ALENYA_SUPABASE_ANON_KEY=
# ALENYA_PANEL_PASSWORD=   # required for Command Center login (no default)
# ALENYA_SESSION_SECRET=
# ALENYA_WHATSAPP_VERIFY_TOKEN=alenya-verify

# --- Meta WhatsApp Cloud API (optional; chat bots / Luxia-Alenya bridge) ---
# Phone Number ID from Meta Developer → WhatsApp → API Setup (digits only).
# WHATSAPP_PHONE_NUMBER_ID=
# META_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_WHATSAPP_TOKEN=

# --- Web3 (optional overrides; defaults use public Polygon RPCs) ---
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
