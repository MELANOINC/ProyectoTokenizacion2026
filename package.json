{
  "name": "notorius",
  "version": "0.1.0",
  "private": true,
  "description": "NOTORIUS™ — Smart Contract Engine + Tokenization Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:full": "npm run compile:contracts && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test NOTORIUS_FORCE_MEMORY=1 tsx --test src/**/*.test.ts",
    "check:env": "node scripts/check-env.mjs",
    "probe:integrations": "tsx scripts/probe-integrations.mjs",
    "compile:contracts": "node scripts/compile-contracts.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "solc": "^0.8.36",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
